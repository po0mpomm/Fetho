{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/career-life",
      "destination": "/career-life.html"
    },
    {
      "source": "/venture-lab",
      "destination": "/venture-lab.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(glb|gltf|woff2|woff|png|jpg|webp|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
